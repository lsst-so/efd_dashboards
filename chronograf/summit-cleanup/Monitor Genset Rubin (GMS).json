				"name": "Running Status Generators",
				"queries": [
					{
						"query": "import \"experimental\"\n\nfrom(bucket: \"efd/autogen\")\n  |> range(start: -10s)\n  |> filter(fn: (r) => r[\"_measurement\"] =~ /lsst.sal.ESS.agcGenset150/)\n  |> last()\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> filter(fn: (r) => r.salIndex == 305 or r.salIndex == 306)  |> map(fn: (r) => ({\n    _time: r._time,\n    salIndex: r.salIndex,\n    generatorModel: if r.salIndex == 306 then \"Caterpillar\" else \"Mitsubishi\",    running: if r.running == true then \"Running\" else \"Stopped\",\n    mode: if r.blockMode then \"BLOCK\" else if r.testMode then \"TEST\" else if r.manualMode then \"MANUAL\" else if r.semiAutoMode then \"SEMI-AUTO\" else if r.autoMode then \"AUTO\" else \"DESCONOCIDO\"\n  }))\n  |> sort(columns: [\"salIndex\"], desc: true)\n  |> keep(columns: [\"_time\", \"salIndex\", \"generatorModel\", \"running\", \"mode\"])",
						"queryConfig": {
							"database": "",
							"measurement": "",
							"retentionPolicy": "",
							"fields": [],
							"tags": {},
							"groupBy": {
								"time": "",
								"tags": []
							},
							"areTagsAccepted": false,
							"rawText": "import \"experimental\"\n\nfrom(bucket: \"efd/autogen\")\n  |> range(start: -10s)\n  |> filter(fn: (r) => r[\"_measurement\"] =~ /lsst.sal.ESS.agcGenset150/)\n  |> last()\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> filter(fn: (r) => r.salIndex == 305 or r.salIndex == 306)  |> map(fn: (r) => ({\n    _time: r._time,\n    salIndex: r.salIndex,\n    generatorModel: if r.salIndex == 306 then \"Caterpillar\" else \"Mitsubishi\",    running: if r.running == true then \"Running\" else \"Stopped\",\n    mode: if r.blockMode then \"BLOCK\" else if r.testMode then \"TEST\" else if r.manualMode then \"MANUAL\" else if r.semiAutoMode then \"SEMI-AUTO\" else if r.autoMode then \"AUTO\" else \"DESCONOCIDO\"\n  }))\n  |> sort(columns: [\"salIndex\"], desc: true)\n  |> keep(columns: [\"_time\", \"salIndex\", \"generatorModel\", \"running\", \"mode\"])",

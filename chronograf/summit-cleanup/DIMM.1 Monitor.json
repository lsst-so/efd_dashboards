				"h": 3,
				"name": "DIMM Condition",
				"queries": [
					{
						"query": "from(bucket: \"efd/autogen\")\n  |> range(start: dashboardTime, stop: upperDashboardTime)\n  |> filter(fn: (r) =>\n    r._measurement == \"lsst.sal.DIMM.ameba\" and\n    r._field == \"condition\"\n  )\n  |> sort(columns: [\"_time\"], desc: true)\n  |> limit(n: 5)\n  |> map(fn: (r) => {\n      n = int(v: r._value)                // bitmask 0..7\n      hum  = if n % 2 == 1 then true else false                    // bit 0 (1)\n      wind = if int(v: n / 2) % 2 == 1 then true else false        // bit 1 (2)\n      sky  = if int(v: n / 4) % 2 == 1 then true else false        // bit 2 (4)\n      all  = hum and wind and sky\n\n      label =\n        (if hum then \"Humidity OK\" else \"\") +\n        (if wind then (if hum then \", Wind OK\" else \"Wind OK\") else \"\") +\n        (if sky then (if hum or wind then \", Sky clear\" else \"Sky clear\") else \"\")\n\n      return {\n        _time: r._time,\n        condition: n,\n        humidity_ok: hum,\n        wind_ok: wind,\n        sky_clear: sky,\n        all_ok: all,\n        conditionName: label\n      }\n    })\n  |> keep(columns: [\"_time\",\"condition\",\"humidity_ok\",\"wind_ok\",\"sky_clear\",\"all_ok\",\"conditionName\"])",

							"areTagsAccepted": false,
							"rawText": "from(bucket: \"efd/autogen\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"lsst.sal.ESS.logevent_ringssMeasurement\")\n  |> filter(fn: (r) =>\n    r[\"_field\"] == \"turbulenceProfiles0\" or\n    r[\"_field\"] == \"turbulenceProfiles1\" or\n    r[\"_field\"] == \"turbulenceProfiles2\" or\n    r[\"_field\"] == \"turbulenceProfiles3\" or\n    r[\"_field\"] == \"turbulenceProfiles4\" or\n    r[\"_field\"] == \"turbulenceProfiles5\" or\n    r[\"_field\"] == \"turbulenceProfiles6\" or\n    r[\"_field\"] == \"turbulenceProfiles7\"\n  )\n  |> map(fn: (r) => ({\n      r with\n      _value:\n        if r._field == \"turbulenceProfiles7\" then      (float(v: r._value) * 1000000000000.0) + 7.0\n        else if r._field == \"turbulenceProfiles6\" then (float(v: r._value) * 1000000000000.0) + 6.0\n        else if r._field == \"turbulenceProfiles5\" then (float(v: r._value) * 1000000000000.0) + 5.0\n        else if r._field == \"turbulenceProfiles4\" then (float(v: r._value) * 1000000000000.0) + 4.0\n        else if r._field == \"turbulenceProfiles3\" then (float(v: r._value) * 1000000000000.0) + 3.0\n        else if r._field == \"turbulenceProfiles2\" then (float(v: r._value) * 1000000000000.0) + 2.0\n        else if r._field == \"turbulenceProfiles1\" then (float(v: r._value) * 1000000000000.0) + 1.0\n        else if r._field == \"turbulenceProfiles0\" then (float(v: r._value) * 1000000000000.0)\n        else 0.0\n    }))",

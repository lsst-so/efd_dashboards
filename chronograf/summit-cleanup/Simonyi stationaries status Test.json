			{
				"i": "ec3da915-ae99-4fdc-ab37-710490a6b0ca",
				"x": 0,
				"y": 0,
				"w": 4,
				"h": 2,
				"name": "Simony status TEST",
				"queries": [
					{
						"query": "azimuthHomed = from(bucket: \"efd/autogen\")\n  |> range(start: -60d) // Large range to ensure the most recent record is found\n  |> filter(fn: (r) => r[\"_measurement\"] == \"lsst.sal.MTMount.logevent_azimuthHomed\" and r[\"_field\"] == \"homed\")\n  |> last()\n  |> map(fn: (r) => ({\n    azimuthHomed: if r._value == true then \"HOMED\" else \"NOT HOMED\"\n    }))\n\nelevationHomed = from(bucket: \"efd/autogen\")\n  |> range(start: -90d) // Large range to ensure the most recent record is found\n  |> filter(fn: (r) => r[\"_measurement\"] == \"lsst.sal.MTMount.logevent_elevationHomed\" and r[\"_field\"] == \"homed\")\n  |> last()\n  |> map(fn: (r) => ({\n    elevationHomed: if r._value == true then \"HOMED\" else \"NOT HOMED\"\n    }))\n\nunion(\n  tables: [azimuthHomed, elevationHomed]\n)\n  |> reduce(\n    identity: {azimuth: \"NOT HOMED\", elevation: \"NOT HOMED\"},\n    fn: (r, accumulator) => ({\n      azimuth: if exists r.azimuthHomed then r.azimuthHomed else accumulator.azimuth,\n      elevation: if exists r.elevationHomed then r.elevationHomed else accumulator.elevation\n    })\n  )\n  |> map(fn: (r) => ({\n    status: if r.azimuth == \"HOMED\" and r.elevation == \"HOMED\" then \"HOMED\"\n            else if r.azimuth == \"HOMED\" and r.elevation == \"NOT HOMED\" then \"AZIMUTH ONLY\"\n            else if r.azimuth == \"NOT HOMED\" and r.elevation == \"HOMED\" then \"ELEVATION ONLY\"\n            else \"NOT HOMED\"\n    }))\n  |> keep(columns: [\"status\"]) // Keep only the final status column\n",
						"queryConfig": {
							"database": "",
							"measurement": "",
							"retentionPolicy": "",
							"fields": [],
							"tags": {},
							"groupBy": {
								"time": "",
								"tags": []
							},
							"areTagsAccepted": false,
							"rawText": "azimuthHomed = from(bucket: \"efd/autogen\")\n  |> range(start: -60d) // Large range to ensure the most recent record is found\n  |> filter(fn: (r) => r[\"_measurement\"] == \"lsst.sal.MTMount.logevent_azimuthHomed\" and r[\"_field\"] == \"homed\")\n  |> last()\n  |> map(fn: (r) => ({\n    azimuthHomed: if r._value == true then \"HOMED\" else \"NOT HOMED\"\n    }))\n\nelevationHomed = from(bucket: \"efd/autogen\")\n  |> range(start: -90d) // Large range to ensure the most recent record is found\n  |> filter(fn: (r) => r[\"_measurement\"] == \"lsst.sal.MTMount.logevent_elevationHomed\" and r[\"_field\"] == \"homed\")\n  |> last()\n  |> map(fn: (r) => ({\n    elevationHomed: if r._value == true then \"HOMED\" else \"NOT HOMED\"\n    }))\n\nunion(\n  tables: [azimuthHomed, elevationHomed]\n)\n  |> reduce(\n    identity: {azimuth: \"NOT HOMED\", elevation: \"NOT HOMED\"},\n    fn: (r, accumulator) => ({\n      azimuth: if exists r.azimuthHomed then r.azimuthHomed else accumulator.azimuth,\n      elevation: if exists r.elevationHomed then r.elevationHomed else accumulator.elevation\n    })\n  )\n  |> map(fn: (r) => ({\n    status: if r.azimuth == \"HOMED\" and r.elevation == \"HOMED\" then \"HOMED\"\n            else if r.azimuth == \"HOMED\" and r.elevation == \"NOT HOMED\" then \"AZIMUTH ONLY\"\n            else if r.azimuth == \"NOT HOMED\" and r.elevation == \"HOMED\" then \"ELEVATION ONLY\"\n            else \"NOT HOMED\"\n    }))\n  |> keep(columns: [\"status\"]) // Keep only the final status column\n",

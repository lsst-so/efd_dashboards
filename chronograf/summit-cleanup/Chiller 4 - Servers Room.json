				"name": "Compresor 4",
				"queries": [
					{
						"query": "import \"math\"\n\n// Parámetros reutilizables\n_bucket = \"efd/autogen\"\n_range = -7d\n\n// Query para estado del chiller\nchiller_status_stream = from(bucket: _bucket)\n  |> range(start: _range)\n  |> filter(fn: (r) =>\n    r._measurement == \"lsst.sal.HVAC.coatingGlycolChiller04\" and\n    r._field == \"compressor04Working\"\n  )\n  |> last() // obtener el último valor reportado\n  |> map(fn: (r) => ({\n    device: \"Compresor 04\",\n    status: if r._value == true then \"WORKING\" else \"NOT WORKING\",\n    last_updated: r._time\n  }))\n  |> keep(columns: [\"device\", \"status\", \"last_updated\"])\n\n// Resultado final\nchiller_status_stream",
						"queryConfig": {
							"database": "",
							"measurement": "",
							"retentionPolicy": "",
